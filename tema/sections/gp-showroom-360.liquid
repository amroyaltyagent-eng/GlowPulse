{%- comment -%}
  GlowPulse · portada de la ficha (27-10): el producto en un expositor de una sala verde agua.
  Al bajar, el vídeo de la vuelta de 360° avanza con el scroll (se reproduce, no salta de fotograma en fotograma).
  Cuando termina la vuelta aparece el botón de comprar; después sigue la ficha tal como está.
{%- endcomment -%}
{%- assign v = section.settings.video -%}
<section class="gp360" id="gp360-{{ section.id }}" data-gp360>
  <div class="gp360__stick">
    {%- if v != blank -%}
      <video class="gp360__vid" muted playsinline preload="auto" disablepictureinpicture
        {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1080 }}"{% endif %}>
        {%- for s in v.sources -%}
          {%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endif -%}
        {%- endfor -%}
      </video>
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 1080 | image_tag: class: 'gp360__vid', alt: section.settings.title }}
    {%- endif -%}
    <div class="gp360__txt">
      <h1 class="gp360__h">{{ section.settings.title }}</h1>
      <p class="gp360__p">{{ section.settings.subtitle }}</p>
    </div>
    <div class="gp360__hint" data-gp360-hint aria-hidden="true">Desliza para verlo por todos lados ↓</div>
    <div class="gp360__buy" data-gp360-buy>
      <a class="gp360__btn" href="{{ section.settings.buy_link | default: '#gp4-choose' }}">{{ section.settings.buy_text }}</a>
      <span class="gp360__sub">{{ section.settings.buy_sub }}</span>
    </div>
  </div>
</section>

<style>
  #gp360-{{ section.id }} { --gp-bg1: {{ section.settings.wall }}; --gp-bg2: {{ section.settings.floor }}; height: {{ section.settings.scroll_vh }}vh; position: relative; background: linear-gradient(180deg, var(--gp-bg1) 0%, var(--gp-bg1) 62%, var(--gp-bg2) 62%, var(--gp-bg2) 100%); }
  #gp360-{{ section.id }} .gp360__stick { position: sticky; top: 0; height: 100svh; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  #gp360-{{ section.id }} .gp360__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #gp360-{{ section.id }} .gp360__txt { position: absolute; top: 9svh; left: 0; right: 0; padding: 0 20px; text-align: center; z-index: 2; }
  #gp360-{{ section.id }} .gp360__h { margin: 0 0 8px; font-size: clamp(26px, 7vw, 46px); line-height: 1.08; color: #10322b; letter-spacing: -.01em; }
  #gp360-{{ section.id }} .gp360__p { margin: 0 auto; max-width: 30em; font-size: clamp(15px, 4vw, 19px); color: #1d4a40; }
  #gp360-{{ section.id }} .gp360__hint { position: relative; z-index: 2; margin-bottom: 6svh; font-size: 14px; color: #10322b; opacity: .85; transition: opacity .4s; }
  #gp360-{{ section.id }} .gp360__buy { position: absolute; left: 0; right: 0; bottom: 7svh; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0; transform: translateY(16px); pointer-events: none; transition: opacity .5s, transform .5s; }
  #gp360-{{ section.id }} .gp360__buy.is-on { opacity: 1; transform: none; pointer-events: auto; }
  #gp360-{{ section.id }} .gp360__btn { display: inline-block; padding: 16px 34px; border-radius: 999px; background: #10322b; color: #fff; font-weight: 700; font-size: 17px; text-decoration: none; box-shadow: 0 10px 30px rgba(16,50,43,.28); }
  #gp360-{{ section.id }} .gp360__sub { font-size: 14px; color: #10322b; background: rgba(255,255,255,.7); padding: 4px 12px; border-radius: 999px; }
  #gp360-{{ section.id }}.is-done .gp360__hint { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { #gp360-{{ section.id }} { height: auto; } #gp360-{{ section.id }} .gp360__stick { position: relative; } #gp360-{{ section.id }} .gp360__buy { opacity: 1; transform: none; pointer-events: auto; } }
</style>

<script>
  (function () {
    var root = document.getElementById('gp360-{{ section.id }}');
    if (!root) return;
    var vid = root.querySelector('video'), buy = root.querySelector('[data-gp360-buy]');
    function done() { root.classList.add('is-done'); buy.classList.add('is-on'); }
    if (!vid || window.matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }
    var dur = 0, ticking = false;
    vid.addEventListener('loadedmetadata', function () { dur = vid.duration || 0; });
    vid.addEventListener('ended', done);
    function progress() {
      var r = root.getBoundingClientRect(), total = root.offsetHeight - window.innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    }
    function step() {
      ticking = false;
      if (!dur) return;
      var p = progress(), target = p * dur, lag = target - vid.currentTime;
      if (p >= 0.985) { if (vid.currentTime < dur - 0.05) { vid.playbackRate = 2; vid.play(); } else { done(); } return; }
      if (lag > 0.08) {
        // Va por detrás del scroll: se reproduce (fluido), más rápido cuanto más lejos esté
        vid.playbackRate = Math.min(2.5, Math.max(0.6, lag * 3));
        if (vid.paused) vid.play();
        requestAnimationFrame(function () { if (!ticking) { ticking = true; step(); } });
      } else if (lag < -0.6) {
        // Ha subido mucho: se recoloca hacia atrás
        vid.pause(); vid.currentTime = target;
      } else {
        vid.pause();
      }
    }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(step); } }, { passive: true });
    // En iOS el vídeo no carga hasta que se toca; se pide la carga al entrar
    vid.load();
  })();
</script>

{% schema %}
{
  "name": "GlowPulse 360 · expositor",
  "settings": [
    { "type": "video", "id": "video", "label": "Vídeo de la vuelta de 360° (vertical, 5-8 s)" },
    { "type": "image_picker", "id": "poster", "label": "Imagen fija (primer fotograma)" },
    { "type": "text", "id": "title", "label": "Título", "default": "Masajeador de cuello GlowPulse" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Sirve para darte un masaje en el cuello en casa, en el sofá o en la cama, sin cables." },
    { "type": "text", "id": "buy_text", "label": "Botón", "default": "Comprar · 59,95 €" },
    { "type": "text", "id": "buy_sub", "label": "Texto bajo el botón", "default": "o 2 por 79,95 € · envío gratis" },
    { "type": "text", "id": "buy_link", "label": "Enlace del botón", "default": "#gp4-choose" },
    { "type": "color", "id": "wall", "label": "Pared", "default": "#BFE6DC" },
    { "type": "color", "id": "floor", "label": "Suelo", "default": "#9FD3C5" },
    { "type": "range", "id": "scroll_vh", "label": "Recorrido de scroll (vh)", "min": 150, "max": 400, "step": 10, "default": 260 }
  ],
  "presets": [{ "name": "GlowPulse 360 · expositor" }]
}
{% endschema %}
