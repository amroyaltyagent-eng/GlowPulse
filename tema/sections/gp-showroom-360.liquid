{%- comment -%}
  GlowPulse · portada de la ficha (v14, 27-10): el producto en un expositor de una sala verde agua.
  Al bajar, el producto da la vuelta de 360° con el scroll (también hacia atrás). Cuando termina aparece el botón de comprar.
  v14: ya no usa <video> (en el móvil, sobre todo iPhone y modo ahorro, el vídeo no se movía con el scroll).
  Ahora son fotogramas sueltos (Contenido > Archivos: gp360-f01.webp … gp360-f60.webp) pintados en un canvas: va en cualquier móvil.
{%- endcomment -%}
{%- assign n = section.settings.frames | default: 60 -%}
{%- assign prefix = section.settings.frames_prefix | default: 'gp360-f' -%}
{%- capture first_name -%}{{ prefix }}01.webp{%- endcapture -%}
<section class="gp360" id="gp360-{{ section.id }}" data-gp360>
  <div class="gp360__stick" data-gp360-stick>
    <canvas class="gp360__vid" width="540" height="960" role="img" aria-label="{{ section.settings.title | escape }} visto por todos lados"
      style="background: center / contain no-repeat url('{{ first_name | file_url }}')"></canvas>
    <div class="gp360__txt">
      <h2 class="gp360__h">{{ section.settings.title }}</h2>
      <p class="gp360__p">{{ section.settings.subtitle }}</p>
    </div>
    <div class="gp360__hint" aria-hidden="true">Desliza para verlo por todos lados ↓</div>
    <div class="gp360__buy" data-gp360-buy>
      <a class="gp360__btn" href="{{ section.settings.buy_link | default: '#gp4-choose' }}">{{ section.settings.buy_text }}</a>
      <span class="gp360__sub">{{ section.settings.buy_sub }}</span>
    </div>
  </div>
</section>

<style>
  #gp360-{{ section.id }} { --gp-bg1: {{ section.settings.wall }}; --gp-bg2: {{ section.settings.floor }}; height: {{ section.settings.scroll_vh }}vh; position: relative; background: linear-gradient(180deg, var(--gp-bg1) 0%, var(--gp-bg1) 50%, var(--gp-bg2) 78%, var(--gp-bg2) 100%); }
  #gp360-{{ section.id }} .gp360__stick { position: -webkit-sticky; position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  #gp360-{{ section.id }}.is-jsstick .gp360__stick { position: absolute; left: 0; right: 0; will-change: transform; }
  #gp360-{{ section.id }} .gp360__vid { position: absolute; left: 50%; bottom: {{ section.settings.lift }}vh; bottom: {{ section.settings.lift }}svh; transform: translateX(-50%); height: {{ section.settings.size }}vh; height: {{ section.settings.size }}svh; width: auto; max-width: none; aspect-ratio: 9 / 16; -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%); mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%); }
  #gp360-{{ section.id }} .gp360__txt { position: absolute; top: 9svh; left: 0; right: 0; padding: 0 20px; text-align: center; z-index: 2; }
  #gp360-{{ section.id }} .gp360__h { margin: 0 0 8px; font-size: clamp(26px, 7vw, 46px); line-height: 1.08; color: #10322b; letter-spacing: -.01em; }
  #gp360-{{ section.id }} .gp360__p { margin: 0 auto; max-width: 30em; font-size: clamp(15px, 4vw, 19px); color: #1d4a40; }
  #gp360-{{ section.id }} .gp360__hint { position: relative; z-index: 2; margin-bottom: 6svh; font-size: 14px; color: #10322b; opacity: .85; transition: opacity .4s; }
  #gp360-{{ section.id }} .gp360__buy { position: absolute; left: 0; right: 0; bottom: 7svh; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0; transform: translateY(16px); pointer-events: none; transition: opacity .5s, transform .5s; }
  #gp360-{{ section.id }} .gp360__buy.is-on { opacity: 1; transform: none; pointer-events: auto; }
  #gp360-{{ section.id }} .gp360__btn { display: inline-block; padding: 16px 34px; border-radius: 999px; background: #10322b; color: #fff; font-weight: 700; font-size: 17px; text-decoration: none; box-shadow: 0 10px 30px rgba(16,50,43,.28); }
  #gp360-{{ section.id }} .gp360__sub { font-size: 14px; color: #10322b; background: rgba(255,255,255,.7); padding: 4px 12px; border-radius: 999px; }
  #gp360-{{ section.id }}.is-done .gp360__hint { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { #gp360-{{ section.id }} { height: auto; } #gp360-{{ section.id }} .gp360__stick { position: relative; } #gp360-{{ section.id }} .gp360__buy { opacity: 1; transform: none; pointer-events: auto; } }
</style>

<script>
  (function () {
    var root = document.getElementById('gp360-{{ section.id }}');
    if (!root) return;
    var urls = [{%- for i in (1..n) -%}{%- capture f -%}{{ prefix }}{% if i < 10 %}0{% endif %}{{ i }}.webp{%- endcapture -%}{{ f | file_url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}];
    var cv = root.querySelector('canvas'), ctx = cv.getContext('2d'), stick = root.querySelector('[data-gp360-stick]'), buy = root.querySelector('[data-gp360-buy]');
    var N = urls.length, imgs = new Array(N), ok = new Array(N), shown = -1, cur = 0, jsStick = false;
    function done() { root.classList.add('is-done'); buy.classList.add('is-on'); }
    function draw(i) {
      // Si ese fotograma aún no ha llegado, se pinta el cargado más cercano
      for (var d = 0; d < N; d++) {
        var j = ok[(i + d) % N] ? (i + d) % N : ok[(i - d + N) % N] ? (i - d + N) % N : -1;
        if (j >= 0) { if (j !== shown) { ctx.drawImage(imgs[j], 0, 0, cv.width, cv.height); shown = j; } return; }
      }
    }
    function load(i) {
      if (imgs[i]) return;
      var im = new Image();
      im.decoding = 'async';
      im.onload = function () { ok[i] = true; if (shown < 0 || i === Math.round(cur) % N) { shown = -2; draw(Math.round(cur) % N); } };
      im.src = urls[i];
      imgs[i] = im;
    }
    // Primero 1 de cada 8 (la vuelta se ve enseguida), luego se rellenan los huecos
    [8, 4, 2, 1].forEach(function (s) { for (var i = 0; i < N; i += s) load(i); });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }

    function tick() {
      requestAnimationFrame(tick);
      var r = root.getBoundingClientRect(), vh = window.innerHeight, total = root.offsetHeight - vh;
      if (r.bottom < -50 || r.top > vh + 50) return;
      var y = Math.min(Math.max(-r.top, 0), Math.max(total, 0));
      // Si algún contenedor del tema impide el sticky, la sala se fija por código
      if (!jsStick && y > 20 && stick.getBoundingClientRect().top < -10) { jsStick = true; root.classList.add('is-jsstick'); }
      if (jsStick) stick.style.transform = 'translate3d(0,' + y + 'px,0)';
      var p = total > 0 ? y / total : 1;
      if (p >= 0.97) done();
      var target = p * (N - 1);
      cur += (target - cur) * 0.3;
      if (Math.abs(target - cur) < 0.05) cur = target;
      draw(Math.round(cur) % N);
    }
    requestAnimationFrame(tick);
  })();
</script>

{% schema %}
{
  "name": "GlowPulse 360 · expositor",
  "settings": [
    { "type": "text", "id": "frames_prefix", "label": "Fotogramas: nombre en Contenido > Archivos sin número", "default": "gp360-f", "info": "Archivos gp360-f01.webp, gp360-f02.webp…" },
    { "type": "number", "id": "frames", "label": "Número de fotogramas", "default": 60 },
    { "type": "text", "id": "title", "label": "Título", "default": "Masajeador de cuello GlowPulse" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Sirve para darte un masaje en el cuello en casa, en el sofá o en la cama, sin cables." },
    { "type": "text", "id": "buy_text", "label": "Botón", "default": "Comprar · 59,95 €" },
    { "type": "text", "id": "buy_sub", "label": "Texto bajo el botón", "default": "o 2 por 79,95 € · envío gratis" },
    { "type": "text", "id": "buy_link", "label": "Enlace del botón", "default": "#gp4-choose" },
    { "type": "color", "id": "wall", "label": "Pared", "default": "#BFE6DC" },
    { "type": "color", "id": "floor", "label": "Suelo", "default": "#9FD3C5" },
    { "type": "range", "id": "size", "label": "Tamaño del producto en pantalla (alto, % de la pantalla)", "min": 30, "max": 100, "step": 2, "default": 58 },
    { "type": "range", "id": "lift", "label": "Altura desde abajo (%)", "min": 0, "max": 30, "step": 1, "default": 12 },
    { "type": "range", "id": "scroll_vh", "label": "Recorrido de scroll (vh)", "min": 150, "max": 400, "step": 10, "default": 260 }
  ],
  "presets": [{ "name": "GlowPulse 360 · expositor" }]
}
{% endschema %}
